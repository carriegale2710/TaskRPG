# Ignore local Second Brain directories (this repo is for setup files only)
/Archives
/Areas
/Projects
/Resources
/Inbox

.git/
.git/*
*.git

# ==========================================
# 🛑 SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.secret
*.pem
*.key

# Ignore local workspace layout and cache to prevent sync conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/*

# OPTIONAL: Ignore all community plugin settings if you store sensitive API tokens
.obsidian/plugins/copilot/*
.obsidian/plugins/obsidian-copilot/*
.obsidian/plugins/fit/*
.obsidian/plugins/git/*
