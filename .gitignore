# SECTION - JUST IN CASE!!!!

# ==========================================
# 🛑 SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.secret
*.pem
*.key

# ==========================================
# 💻 OPERATING SYSTEM FILES
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ==========================================
# 📦 COMMON DEPENDENCIES & PACKAGE MANAGERS
# ==========================================
# JavaScript / Node.js
node_modules/
jspm_packages/
.pnpm-store/
.yarn/
! .yarn/releases/
! .yarn/plugins/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# PHP / Ruby
vendor/
.bundle/

# ==========================================
# 🚀 BUILD OUTPUTS & COMPILED CODE
# ==========================================
dist/
build/
out/
target/
*.com
*.class
*.dll
*.exe
*.o
*.so

# ==========================================
# 📝 LOGS & DATABASES
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.sql
*.sqlite
*.db

# ==========================================
# 🛠️ IDE & CODE EDITORS (OPTIONAL / PERSONAL)
# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# IntelliJ / WebStorm / PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace
